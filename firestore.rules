rules_version = '2';
// Heo Con Club — paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{db}/documents {
    // private save of one player
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
                         && (request.resource == null || request.resource.size() < 900 * 1024);
    }
    // public card shown on the leaderboard / online list; only its owner writes it
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['name', 'av', 'fr', 'coins', 'lv', 'vip', 'won', 'seen'])
                   && request.resource.data.name is string && request.resource.data.name.size() <= 20;
    }
    // tables with friends: signed-in players read; seats join/leave; the host publishes the state
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null && (resource.data.host == request.auth.uid
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats', 'updated', 'open', 'host', 'hb']));
      match /moves/{id} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.by == request.auth.uid;
      }
    }
  }
}
